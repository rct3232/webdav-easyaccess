{
  "name": "webdav-easyaccess-server",
  "version": "1.0.0",
  "description": "Express.js backend for WebDAV EasyAccess",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 jest",
    "test:unit": "NODE_OPTIONS=--max-old-space-size=8192 jest --testMatch='**/(utils|models|middleware)/**/*.test.js'",
    "test:integration": "NODE_OPTIONS=--max-old-space-size=8192 jest --testMatch='**/routes/**/*.test.js'",
    "test:ci": "NODE_OPTIONS=--max-old-space-size=8192 jest --ci --coverage --maxWorkers=2",
    "test:coverage": "NODE_OPTIONS=--max-old-space-size=8192 jest --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@webdav-easyaccess/shared": "1.0.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fluent-ffmpeg": "^2.1.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.11",
    "sharp": "^0.32.6",
    "webdav": "^5.3.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/jest-runner": "^9.5.1",
    "@types/jest": "^30.0.0",
    "fast-check": "^3.22.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}