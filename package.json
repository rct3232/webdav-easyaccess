{
  "name": "webdav-easyaccess",
  "version": "1.0.0",
  "description": "WebDAV file management service with Google Drive-like UI",
  "main": "server/index.js",
  "workspaces": ["client", "server", "shared"],
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "build": "cd client && npm run build"
  },
  "keywords": ["webdav", "file-management", "react", "express"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

