###############################################################################
# 1. File Storage Settings (Default: s3)
###############################################################################

# File content blob storage backend: 's3' (default) or 'webdav'
# s3 is the default; the S3 variables below are required unless you set
# WEA_FILE_STORAGE=webdav (see the WebDAV block in section 7).
WEA_FILE_STORAGE=s3

# S3 bucket name
S3_BUCKET=your-bucket-name

# AWS region
AWS_REGION=us-east-1

# S3/MinIO credentials
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Custom S3 endpoint URL for MinIO/compatible services (optional; forces path-style access)
S3_ENDPOINT=http://localhost:9000


###############################################################################
# 2. Server & Security Settings (Required)
###############################################################################

# Application server port (default: 5001)
PORT=5001

# Secret key for JWT signing (MUST be changed in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiration time (e.g., 30m, 1h, 7d)
JWT_EXPIRES_IN=30m

# Allowed CORS origins (comma-separated, recommended for production)
# CORS_ORIGINS=https://your-app.com,https://admin.your-app.com


###############################################################################
# 3. Metadata Storage Settings (Optional)
###############################################################################

# Storage backend: 'sqlite' (default), 'postgresql'
# WEA_STORAGE_BACKEND=sqlite

# PostgreSQL metadata backend settings (required when WEA_STORAGE_BACKEND=postgresql)
# WEA_PG_HOST=localhost
# WEA_PG_PORT=5432
# WEA_PG_DATABASE=webdav_easyaccess
# WEA_PG_USER=postgres
# WEA_PG_PASSWORD=your-password

# Optional PostgreSQL pool/SSL settings
# WEA_PG_SSL=false
# WEA_PG_MAX=10
# WEA_PG_IDLE_TIMEOUT_MS=30000
# WEA_PG_CONNECTION_TIMEOUT_MS=10000

# PostgreSQL SSL mode used by some tools/clients (prefer/require/disable)
# PGSSLMODE=prefer

# SQLite database path (required when WEA_STORAGE_BACKEND=sqlite)
# WEA_SQLITE_PATH=./data/webdav.db


###############################################################################
# 3b. Garbage Collection & Fail-safe Recovery Settings (Optional)
###############################################################################

# Optional GC cron interval in milliseconds. 0 or unset disables periodic GC
# (GC is always available on demand via POST /api/admin/maintenance/gc).
# GC_INTERVAL_MS=21600000

# Minimum age in days before an orphaned blob/object_map row is collected.
# GC_ORPHAN_TTL_DAYS=1


###############################################################################
# 4. Email Notification Settings (Optional - SMTP)
###############################################################################

# SMTP server host and port
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

# Use secure connection (TLS) (true/false)
# EMAIL_SECURE=false

# SMTP authentication credentials
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# Email sender display name
# EMAIL_FROM_NAME=WebDAV EasyAccess


###############################################################################
# 5. Thumbnail & Media Processing Settings (Optional)
###############################################################################

# Max resolution of generated thumbnails (in pixels)
# MAX_THUMBNAIL_SIZE=300

# Full path to FFmpeg executable (only needed if not in system PATH)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Max concurrent tasks for thumbnail generation
# THUMBNAIL_CONCURRENCY_LIMIT=10


###############################################################################
# 6. Admin & Registration Policy Settings (Optional)
###############################################################################

# Initial password for the automatically created 'admin' account
# ADMIN_DEFAULT_PASSWORD=admin

# Whether to disable automatic creation of the default 'admin' account (true/false)
# WEA_DISABLE_DEFAULT_ADMIN=true


###############################################################################
# 7. Optional: WebDAV File Storage (only when WEA_FILE_STORAGE=webdav)
###############################################################################

# Base URL of the WebDAV server (e.g., https://dav.example.com)
# WEBDAV_URL=https://your-webdav-server.com

# Credentials for the WebDAV server
# WEBDAV_USERNAME=your-username
# WEBDAV_PASSWORD=your-password

# WebDAV authentication method: 'auto' (default), 'basic', or 'digest'
# WEBDAV_AUTH_TYPE=auto

# Upstream URL to resolve MOVE/COPY header issues in some proxy environments
# WEBDAV_UPSTREAM_URL=http://your-upstream-host:port


###############################################################################
# 8. WebDAV Docker Development Helpers (Informational)
###############################################################################

# The following npm scripts manage a local WebDAV server via Docker for development:
#
#   npm run dev:webdav:start   — Start the WebDAV Docker container
#   npm run dev:webdav:stop    — Stop and remove the WebDAV Docker container


###############################################################################
# 9. E2E Testing Configuration (Informational)
###############################################################################

# Playwright E2E runs in two backend modes, selected via E2E_BACKEND_MODE:
#   s3     (default) → S3 + PostgreSQL (new architecture)  uses `.env.e2e`
#   webdav (legacy)  → WebDAV + PostgreSQL (legacy mode)   uses `.env.e2e.webdav`
#
# The root package scripts consume E2E_BACKEND_MODE to pick the env file for
# the host-run E2E server:
#
#   npm run test:e2e              # s3 (default)
#   npm run test:e2e:s3           # explicit S3+PG
#   npm run test:e2e:webdav       # WebDAV+PG (legacy)
#   npm run e2e:server            # standalone E2E server (defaults to s3)
#   E2E_BACKEND_MODE=webdav npm run e2e:server   # standalone E2E server (webdav)
#
# Required variables when E2E_BACKEND_MODE=s3 (see `.env.e2e`):
#   WEA_STORAGE_BACKEND=postgresql
#   WEA_FILE_STORAGE=s3
#   S3_BUCKET / AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
#   S3_ENDPOINT=http://127.0.0.1:9010          # host-exposed MinIO port
#   WEA_PG_HOST=127.0.0.1 / WEA_PG_PORT=5433   # host-exposed PostgreSQL port
#
# Required variables when E2E_BACKEND_MODE=webdav (see `.env.e2e.webdav`):
#   WEA_STORAGE_BACKEND=postgresql
#   WEA_FILE_STORAGE=webdav                    # no S3 variables required
#   WEBDAV_URL=http://127.0.0.1:8090           # host-exposed WebDAV port
