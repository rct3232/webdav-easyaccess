PORT=5002
NODE_ENV=test
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

WEBDAV_URL=http://127.0.0.1:8090
WEBDAV_UPSTREAM_URL=http://127.0.0.1:8090
WEBDAV_USERNAME=e2etest
WEBDAV_PASSWORD=e2etest123

JWT_SECRET=e2e-test-secret
ADMIN_DEFAULT_PASSWORD=admin

# Essential-only E2E run: `npm run test:e2e:core` (E2E_CORE=1) skips the
# non-essential suites (mypage-admin, setup-wizard, admin-config, migration).
# Suite selection is configured in `playwright.config.ts`; this server env file
# does not control it. Full suite is the default (`npm run test:e2e`).

# Suppress server/client/Docker output during e2e tests
E2E_QUIET=1

# S3 + PostgreSQL E2E configuration
WEA_FILE_STORAGE=s3
S3_BUCKET=e2e-test-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://127.0.0.1:9010
WEA_DB_HOST=127.0.0.1
WEA_DB_PORT=5433
WEA_DB_DATABASE=webdav_e2e
WEA_DB_USER=e2etest
WEA_DB_PASSWORD=e2etest
