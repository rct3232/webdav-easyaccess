{
  "name": "webdav-easyaccess",
  "version": "1.0.0",
  "description": "WebDAV file management service with Google Drive-like UI",
  "main": "server/index.js",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm run dev --workspace server",
    "client": "npm run start --workspace client",
    "build": "npm run build --workspace client",
    "e2e:server": "DOTENV_CONFIG_PATH=../.env.e2e NODE_ENV=test npm run dev --workspace server",
    "e2e:client": "BROWSER=none PORT=3000 REACT_APP_API_PORT=5002 npm run start --workspace client",
    "test:e2e": "playwright test --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium webkit",
    "lint": "npm run lint --workspace server && npm run lint --workspace client",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "webdav",
    "file-management",
    "react",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^8.2.2",
    "prettier": "^3.8.3"
  }
}
