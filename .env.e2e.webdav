PORT=5002
NODE_ENV=test
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

WEBDAV_URL=http://127.0.0.1:8090
WEBDAV_UPSTREAM_URL=http://127.0.0.1:8090
WEBDAV_USERNAME=e2etest
WEBDAV_PASSWORD=e2etest123

JWT_SECRET=e2e-test-secret
ADMIN_DEFAULT_PASSWORD=admin

# E2E Test Wave Gating
# Set to '1' to enable P1/P2 follow-up tests (E2E-SHARE-010, E2E-SHARE-011, etc.)
# Set to '0' or leave empty to run only P0 tests
E2E_LATER_WAVES=0

# Suppress server/client/Docker output during e2e tests
E2E_QUIET=1

# WebDAV + PostgreSQL E2E configuration (legacy mode)
WEA_STORAGE_BACKEND=postgresql
WEA_FILE_STORAGE=webdav
WEA_PG_HOST=127.0.0.1
WEA_PG_PORT=5433
WEA_PG_DATABASE=webdav_e2e
WEA_PG_USER=e2etest
WEA_PG_PASSWORD=e2etest
