{
  "name": "webdav-easyaccess-client",
  "version": "1.0.0",
  "description": "React frontend for WebDAV EasyAccess",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@webdav-easyaccess/shared": "1.0.0",
    "i18next": "^25.8.10",
    "plyr": "^3.8.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-i18next": "^16.5.4",
    "react-pdf": "^10.3.0",
    "react-router-dom": "^6.20.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false --coverage",
    "test:integration": "react-scripts test --testPathPattern=integration --watchAll=false",
    "test:unit": "react-scripts test --testPathPattern='(hooks|utils|components)/__tests__' --watchAll=false",
    "test:coverage": "react-scripts test --watchAll=false --coverage --collectCoverageFrom='src/**/*.{js,jsx}' --collectCoverageFrom='!src/index.js' --collectCoverageFrom='!src/setupTests.js' --collectCoverageFrom='!src/setupProxy.js' --collectCoverageFrom='!src/mocks/**' --collectCoverageFrom='!src/test-utils/**'",
    "eject": "react-scripts eject",
    "test:mutation": "stryker run"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/jest-runner": "^9.5.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "fast-check": "^3.22.0",
    "msw": "^2.12.7",
    "react-scripts": "5.0.1",
    "undici": "^7.18.2"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(msw|@bundled-es-modules|@open-draft|until-async|strict-event-emitter)/)"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    }
  }
}
